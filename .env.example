# pnpm db:setup generates .env.local with random local credentials.
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://salesmora:replace-with-random-local-password@127.0.0.1:55432/salesmora
TEST_DATABASE_URL=postgresql://salesmora:replace-with-random-local-password@127.0.0.1:55432/salesmora_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
# Customer-app origin used for workspace invitation links and email delivery.
CUSTOMER_APP_URL=http://127.0.0.1:3000
# Same random 32+ byte secret on the admin and web services; authorizes only signed admin verification-email requests.
ADMIN_EMAIL_VERIFICATION_SECRET=replace-with-a-dedicated-random-secret
# Dedicated shared 32+ byte secret for signed Super Admin customer-email-change delivery requests.
ADMIN_EMAIL_CHANGE_SECRET=replace-with-a-separate-random-secret
# Public form rendering uses a separate host; production: https://forms.salesmora.ai.
# Leave unset until the public service is configured. Rendering does not enable submission.
CAPTURE_PUBLIC_ORIGIN=
# Independent random 32-byte key encoded as canonical base64, used only for signed form contexts.
CAPTURE_CONTEXT_SECRET=
# Explicit submit opt-in. Publication/production rollout remains a separate reviewed checkpoint.
CAPTURE_SUBMISSIONS_ENABLED=false
# Website activation is independently scoped; no wildcard/all-workspace activation.
CAPTURE_WEBSITE_PUBLICATION_ENABLED=false
CAPTURE_PUBLICATION_WORKSPACE_IDS=
# Dedicated independent 32-byte canonical base64 server token; web + worker only.
CAPTURE_READINESS_SECRET=
# Capture scheduling can be enabled without changing WORKER_TASKS.
CAPTURE_SCHEDULER_ENABLED=false
CAPTURE_READINESS_URL=
# Independent 32-byte canonical base64 secret for short-lived per-form/IP digests.
CAPTURE_ABUSE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Production: verified-header plus a trusted edge that strips incoming claims and injects
# x-capture-ingress-key and exactly one validated IP in the configured header.
# Local loopback hosts may explicitly use loopback (one shared test bucket).
CAPTURE_CLIENT_IP_MODE=
CAPTURE_INGRESS_SECRET=
CAPTURE_TRUSTED_IP_HEADER=
# Explicit deployment-wide/source request and workspace retained-input budgets are required
# outside loopback development. Values are chosen in the concrete rollout configuration.
CAPTURE_REQUESTS_PER_MINUTE=
CAPTURE_SOURCE_REQUESTS_PER_MINUTE=
CAPTURE_MAX_PENDING_ITEMS=
CAPTURE_MAX_RETAINED_BYTES=
CAPTURE_CHALLENGE_AFTER=5
CAPTURE_ATTEMPT_LIMIT=20
# Separate forms-gateway service only; reviewed staging fragments are in infra/forms-gateway/.
CAPTURE_UPSTREAM_URL=
CAPTURE_GATEWAY_EDGE=railway
CAPTURE_GATEWAY_MAX_INFLIGHT=32
TERMS_VERSION=development-draft-2026-10-09

# Gmail Lead Capture: defaults-off OAuth/account controls; ingestion is a later checkpoint.
# Server-only, independent of login credentials and FILE_MASTER_KEY. Never commit real keys.
# JSON keyring: {"local-v1":"<base64 encoding of 32 random bytes>"}; keep retired keys for restore/rotation.
CAPTURE_GMAIL_ACTIVE_KEY_ID=local-v1
CAPTURE_GMAIL_CREDENTIAL_KEYS=
# OAuth connection pilot only; configuring these does not enable Gmail intake.
CAPTURE_GMAIL_CONNECTIONS_ENABLED=false
CAPTURE_GMAIL_ENVIRONMENT=local
# Explicit connection pilot scope (comma-separated workspace UUIDs). This does not enable ingestion.
CAPTURE_GMAIL_WORKSPACE_IDS=
CAPTURE_GMAIL_CLIENT_ID=
CAPTURE_GMAIL_CLIENT_SECRET=
CAPTURE_GMAIL_REDIRECT_URI=http://localhost:3000/api/lead-capture/gmail/oauth/callback

# Enable only explicitly listed workspace:source pairs on the web and dedicated worker.
CAPTURE_GMAIL_DELIVERY_ENABLED=false
CAPTURE_GMAIL_DELIVERY_SOURCES=
# Start the isolated process with WORKER_TASKS=gmail and worker database credentials.

# S3-compatible file storage. Local: RustFS from compose.yaml. Deployed: Railway bucket
# (BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, ENDPOINT mapped to these names).
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_BUCKET=salesmora-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-random-local-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-random-local-secret
OBJECT_STORAGE_URL_STYLE=path
# Master key (32 random bytes, base64) wrapping per-file encryption keys. Never commit a real one.
FILE_MASTER_KEY=replace-with-base64-32-random-bytes

# Separate AES-256-GCM master key for Admin workspace export artifacts.
# Keep separate from FILE_MASTER_KEY. Configure this key on web and worker;
# enable the Admin export UI and worker only after private storage and the key are ready.
ADMIN_WORKSPACE_EXPORTS_ENABLED=false
ADMIN_EXPORT_MASTER_KEY=replace-with-base64-32-random-bytes
# Local development only: identity injected by the Admin proxy instead of Cloudflare Access.
ADMIN_ACCESS_DEV_EMAIL=

# Server-only development embedding credentials. Never use NEXT_PUBLIC_ for keys.
OPENAI_API_KEY=
# This slice pins text-embedding-3-small / 1536 in code. Reindex explicitly to change it.
REDIS_URL=redis://127.0.0.1:56379

# Explicit server-side opt-in for bounded chat. Keep deployments disabled until release review.
CHAT_ENABLED=false
CHAT_MODEL=gpt-6-luna
CHAT_MONTHLY_WORKSPACE_TOKENS=5000000
# Keep LangSmith/LangChain tracing disabled; prompts and tools are not logged.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Worker process: local commands keep guarded Docker URLs/queue names.
# Production requires an explicit distinct queue name, e.g. salesmora-production-help.
WORKER_QUEUE_NAME=
# all = help embedding + retention; retention needs no OpenAI credential.
WORKER_TASKS=all

# Local Mailpit by default. Railway staging uses resend with server-only secrets.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=
RESEND_API_KEY=
# Explicit Estimate Send/customer-link rollout on Railway staging only; local Mailpit needs no flag.
ESTIMATE_EMAIL_ENABLED=false

BILLING_SANDBOX_ENABLED=false
# Stripe sandbox only. Hosted Checkout requires no browser-side secret.
# Populate in ignored .env.local; setup-stripe-sandbox.mts saves sandbox price IDs.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Technical CSV export row cap, independent of subscription allowances.
LEAD_EXPORT_ROW_LIMIT=50000
