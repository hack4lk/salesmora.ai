# Reviewed first-hosting proposal; set these in Railway's forms-gateway service.
# Do not use this file as a populated secret store.
PORT=8080
CAPTURE_PUBLIC_ORIGIN=https://forms-staging.salesmora.ai
CAPTURE_UPSTREAM_URL=http://${{web.RAILWAY_PRIVATE_DOMAIN}}:${{web.PORT}}
CAPTURE_GATEWAY_EDGE=railway
CAPTURE_GATEWAY_MAX_INFLIGHT=32
# Independent 32 random bytes, canonical base64, sealed in gateway and web only.
CAPTURE_INGRESS_SECRET=
