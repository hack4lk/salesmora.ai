# Additive fragment for existing staging web; preserve its existing auth/database/provider variables.
CAPTURE_PUBLIC_ORIGIN=https://forms-staging.salesmora.ai
CAPTURE_CONTEXT_SECRET=
CAPTURE_ABUSE_SECRET=
CAPTURE_INGRESS_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTURE_CLIENT_IP_MODE=verified-header
CAPTURE_TRUSTED_IP_HEADER=x-real-ip
CAPTURE_REQUESTS_PER_MINUTE=300
CAPTURE_SOURCE_REQUESTS_PER_MINUTE=100
CAPTURE_MAX_PENDING_ITEMS=1000
CAPTURE_MAX_RETAINED_BYTES=16777216
CAPTURE_CHALLENGE_AFTER=5
CAPTURE_ATTEMPT_LIMIT=20
# Change only in the approved canary phase after schema/gateway/TLS/credential checks.
CAPTURE_SUBMISSIONS_ENABLED=false
CAPTURE_WEBSITE_PUBLICATION_ENABLED=false
CAPTURE_PUBLICATION_WORKSPACE_IDS=
# Dedicated readiness token shared only with the worker; distinct from all other keys.
CAPTURE_READINESS_SECRET=
