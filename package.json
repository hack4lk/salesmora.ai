    "test:admin-rollout-flags:db": "pnpm --filter @salesmora/admin test:rollout-flags:db",
    "test:admin-operations:db": "pnpm --filter @salesmora/admin test:operations:db",
    "test:admin-workspace-exports:db": "pnpm --filter @salesmora/worker test:admin-workspace-exports",
    "test:admin-audit-preparation:db": "pnpm --filter @salesmora/data test:admin-audit-preparation",
