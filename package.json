    "knowledge:evaluate": "pnpm --filter @salesmora/worker evaluate",
    "ai:usage": "pnpm --filter @salesmora/data usage:report",
    "ai:budget": "pnpm --filter @salesmora/data budget:configure",
    "test:chat:retention": "pnpm --filter @salesmora/data test:retention",
    "worker:start": "pnpm --filter @salesmora/worker start",
    "worker:status": "pnpm --filter @salesmora/worker status",
    "stripe:listen": "node scripts/listen-stripe-sandbox.mjs",
    "test:lead-capture:db": "pnpm --filter @salesmora/data test:lead-capture",
    "test:lead-admission:db": "pnpm --filter @salesmora/data test:lead-admission",
    "test:lead-capture-drafts:db": "pnpm --filter @salesmora/data test:lead-capture-drafts",
    "test:lead-capture-gmail:db": "pnpm --filter @salesmora/data test:lead-capture-gmail",
    "test:lead-capture-gmail-connections:db": "pnpm --filter @salesmora/data test:lead-capture-gmail-connections",
    "test:lead-capture-gmail:e2e": "node scripts/capture-gmail-e2e.mjs",
    "test:lead-capture-drafts:e2e": "node scripts/lead-capture-e2e.mjs",
    "test:lead-capture-activation:e2e": "node scripts/lead-capture-e2e.mjs --activation",
    "test:lead-capture-lifecycle:e2e": "node scripts/lead-capture-e2e.mjs --lifecycle",
    "test:lead-capture-lifecycle:db": "pnpm --filter @salesmora/data test:lead-capture-lifecycle",
    "test:lead-capture-publication:db": "pnpm --filter @salesmora/data test:lead-capture-publication",
    "test:lead-assignment:db": "pnpm --filter @salesmora/data test:lead-assignment",
    "test:lead-capture-public:db": "pnpm --filter @salesmora/data test:lead-capture-public",
    "test:lead-capture-public:e2e": "node scripts/public-capture-e2e.mjs",
    "test:forms-gateway": "node --test infra/forms-gateway/gateway.test.mjs",
    "test:forms-gateway:container": "node scripts/rehearse-forms-gateway.mjs",
    "capture:smoke": "node scripts/smoke-public-capture.mjs",
    "test:lead-capture-submissions:db": "pnpm --filter @salesmora/data test:lead-capture-submissions",
    "test:lead-capture-submissions:e2e": "node scripts/public-capture-submission-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "^8.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "railway": "3.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
