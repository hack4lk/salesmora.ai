{
  "name": "salesmora",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @salesmora/web dev\" \"pnpm --filter @salesmora/worker dev\"",
    "web:dev": "pnpm --filter @salesmora/web dev",
    "worker:dev": "pnpm --filter @salesmora/worker dev",
    "storybook": "pnpm --filter @salesmora/web storybook",
    "storybook:build": "pnpm --filter @salesmora/web storybook:build",
    "admin:dev": "pnpm --filter @salesmora/admin dev",
    "admin:build": "pnpm --filter @salesmora/admin build",
    "admin:typecheck": "pnpm --filter @salesmora/admin typecheck",
    "admin:bootstrap": "pnpm --filter @salesmora/admin admin:bootstrap",
