    "test:admin-billing-recovery:db": "pnpm --filter @salesmora/data test:admin-billing-recovery",
    "test:account-actions:db": "pnpm --filter @salesmora/data test:account-actions",
    "test:admin-email-change-signature": "pnpm --filter @salesmora/data test:admin-email-change-signature",
    "test:email-change:db": "pnpm --filter @salesmora/data test:email-change",
    "test:web-email-change:db": "pnpm --filter @salesmora/data test:email-change-bridge",
    "test:team-actions:db": "pnpm --filter @salesmora/data test:team-actions",
    "test:ownership-transfer:db": "pnpm --filter @salesmora/data test:ownership-transfer",
