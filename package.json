    "admin:storybook:build": "pnpm --filter @salesmora/admin storybook:build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter @salesmora/web test:e2e",
    "db:setup": "node scripts/setup-local.mjs",
    "db:migrate": "pnpm --filter @salesmora/data migrate",
